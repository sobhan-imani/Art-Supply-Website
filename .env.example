# Copy to .env (kept out of git) and fill in. Real environment variables always
# win over this file, so a stale .env on a server can never override the process.

# --- required in production ---
DJANGO_DEBUG=0
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=artsupply.example.com,www.artsupply.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://artsupply.example.com

# --- database: leave DATABASE_NAME empty to use the local sqlite file ---
DATABASE_NAME=artsupply
DATABASE_USER=artsupply
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- files ---
DJANGO_STATIC_ROOT=/var/www/artsupply/static
DJANGO_MEDIA_ROOT=/var/www/artsupply/media

# --- e-mail: leave EMAIL_HOST empty to print mail to the console ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Art Supply <no-reply@artsupply.example.com>

# --- behind a TLS terminating proxy (nginx, a PaaS router) ---
DJANGO_TRUST_PROXY_SSL_HEADER=1

# --- misc ---
DJANGO_TIME_ZONE=Asia/Tehran
DJANGO_LOG_LEVEL=INFO
ORDERS_LOG_LEVEL=INFO
# Comma separated ISO country codes to block, needs the country middleware.
RESTRICTED_COUNTRY_CODES=
